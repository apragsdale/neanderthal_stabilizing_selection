Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"wbar", "=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "\[Pi]", " ", "VG"}], "]"}]}], 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x", "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "VG"}], ")"}]}], "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x", "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "VS"}], ")"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{
       RowBox[{"VG", ">", "0"}], "\[And]", 
       RowBox[{"VG", "\[Element]", "Reals"}], "\[And]", 
       RowBox[{"VS", ">", "0"}], "\[And]", 
       RowBox[{"VS", "\[Element]", "Reals"}]}]}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"w11", "=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "\[Pi]", " ", "VG"}], "]"}]}], 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"2", "p", " ", "a"}]}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "VG"}], ")"}]}], "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"2", "a"}]}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "VS"}], ")"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{
       RowBox[{"VG", ">", "0"}], "\[And]", 
       RowBox[{"VG", "\[Element]", "Reals"}], "\[And]", 
       RowBox[{"VS", ">", "0"}], "\[And]", 
       RowBox[{"VS", "\[Element]", "Reals"}]}]}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"w01", "=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "\[Pi]", " ", "VG"}], "]"}]}], 
