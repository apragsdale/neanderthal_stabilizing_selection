      RowBox[{
       RowBox[{"VG", ">", "0"}], ",", 
       RowBox[{"VS", ">", "0"}], ",", 
       RowBox[{"Ne", ">", "0"}]}], "}"}]}]}], "]"}]}]}], "Input",
