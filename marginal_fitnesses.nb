Cell["\<\
Expected mean fitness, assuming normal distribution with mean zero and \
variance VS/2Ne for the mean phenotype of a population.
We could also plug in the SHOC model for expected VG, depending on Ne, VS, \
and mu.\
\>", "Text",
 CellChangeTimes->{{3.919255567591153*^9, 
  3.91925563009554*^9}},ExpressionUUID->"dc7ede66-c9fe-4805-acf4-\
67e7920bbafa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "pbar_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "\[Pi]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"VS", "/", "2"}], "/", "Ne"}], ")"}]}], "]"}]}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"pbar", "^", "2"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"VS", "/", "2"}], "/", "Ne"}]}], ")"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "p_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "\[Pi]", " ", "VG"}], "]"}]}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "-", "pbar"}], ")"}], "^", "2"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "VG"}], ")"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "[", "p_", "]"}], ":=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "pbar", "]"}], "*", 
     RowBox[{"g", "[", "p", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"pbar", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"VG", ">", "0"}], ",", 
       RowBox[{"VS", ">", "0"}], ",", 
       RowBox[{"Ne", ">", "0"}]}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.8917851890963907`*^9, 3.891785197224977*^9}, {
