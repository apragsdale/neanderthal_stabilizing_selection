  RowBox[{
   RowBox[{"w", "[", "p_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"p", "^", "2"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "VS"}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Ef", "=", 
